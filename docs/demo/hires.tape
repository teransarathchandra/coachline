# Sourced by prompt.tape and website.tape after common.tape: the same terminal at twice the size, so docs/demo/zoom.py can zoom in
# on the coachline pane with the text still sharp.
Set Width 2800
Set Height 1720
Set FontSize 28
Set Padding 36
Set Margin 32
Set BorderRadius 20
Set WindowBarSize 60
Set Framerate 25
