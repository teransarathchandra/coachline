# Shared by every tape in docs/demo (Source docs/demo/common.tape). Catppuccin Mocha with a deeper blue, so the white-on-blue chips
# (coachline, Copied) stay readable, and a true bright white for your prompt.
Set Shell "bash"
Set FontSize 15
Set Width 1060
Set Height 700
Set Padding 18
Set Theme { "name": "coachline-demo", "background": "#1e1e2e", "foreground": "#cdd6f4", "cursor": "#f5e0dc", "selection": "#585b70", "black": "#45475a", "red": "#f38ba8", "green": "#a6e3a1", "yellow": "#f9e2af", "blue": "#3a5cc5", "magenta": "#f5c2e7", "cyan": "#94e2d5", "white": "#cdd6f4", "brightBlack": "#6c7086", "brightRed": "#f38ba8", "brightGreen": "#a6e3a1", "brightYellow": "#f9e2af", "brightBlue": "#89b4fa", "brightMagenta": "#f5c2e7", "brightCyan": "#94e2d5", "brightWhite": "#ffffff" }
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 16
Set MarginFill "#11111b"
Set TypingSpeed 30ms
