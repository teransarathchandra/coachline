{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/scripts/setup.py\"; (python3 \"$S\" --refresh || python \"$S\" --refresh || py -3 \"$S\" --refresh) >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
